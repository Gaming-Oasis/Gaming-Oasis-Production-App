{
  "name": "gaming-oasis-production-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/local-runner.mjs dev",
    "dev:web": "vinext dev",
    "build": "node scripts/clean-dist.mjs && vinext build",
    "start": "node scripts/local-runner.mjs start",
    "start:web": "vinext start",
    "writer": "node scripts/json-writer.mjs",
    "test": "npm run build && node --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev",
    "audit:toolchain": "npm audit"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  },
  "type": "module"
}
