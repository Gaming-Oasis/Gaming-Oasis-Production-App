export type PhantomRow = { id: string; label: string; value: string; team: string; identity: string; dependsOn: string; index: number };
export type PhantomSnapshot = { key: string; scope: string; rows: PhantomRow[]; banSwap: boolean; blueTeam: string; firstPickSide: string; bluePickOrder: number[]; redPickOrder: number[] };
export type PhantomDraft = { version: number; enabled: boolean; snapshot: PhantomSnapshot | null; revealed: string[]; running: boolean; deadline: number; pending: string; revision: number; reason: string };
export type PhantomStatus = { enabled: boolean; ready: boolean; sourceReady: boolean; rows: (PhantomRow & { stagedValue: string; revealed: boolean; canReveal: boolean })[]; changes: { label: string; before: string; after: string }[]; count: number; running: boolean; deadline: number; pending: boolean; reason: string; next: string };
export function resetPhantom(value?: unknown, enabled?: boolean): PhantomDraft;
export function restorePhantom(value: unknown): PhantomDraft;
export function phantomMatchKey(state: unknown): string;
export function phantomStatus(game: unknown, key: string, matchKey?: string): PhantomStatus;
export function phantomAction<T>(game: T, key: string, matchKey: string, action: string, id?: string, now?: number): T;
export function phantomBroadcast<T>(game: T, key: string, matchKey?: string): T;
export function reconcilePhantom<T>(game: T, key: string, matchKey?: string): T;
export function reconcilePhantoms<T>(state: T): T;
export function tickPhantoms<T>(state: T, now: number): T;
export function pausePhantom<T>(game: T, reason?: string): T;
export function pausePhantoms<T>(state: T, reason?: string): T;
export function phantomTickets(state: unknown): Record<string, string>;
export function acknowledgePhantom<T>(game: T, ticket: string, now?: number, random?: () => number): T;
export function acknowledgePhantoms<T>(state: T, tickets: Record<string, string>, now?: number, random?: () => number): T;
export function revealDelay(random?: () => number): number;
